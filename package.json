{
  "name": "lowgate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench": "node --env-file-if-exists=.env packages/decisions/scripts/bench.ts",
    "agree": "node packages/decisions/scripts/agree.ts",
    "dev": "pnpm --filter @lowgate/web dev",
    "build": "pnpm --filter @lowgate/web build",
    "laya-dataset": "node packages/decisions/scripts/laya-dataset.ts",
    "laya-dagger": "node packages/decisions/scripts/laya-dagger.ts",
    "probe": "node --env-file-if-exists=.env packages/decisions/scripts/probe.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy:web": "pnpm build && cd apps/web && ../../node_modules/.bin/wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.130.0"
  }
}
