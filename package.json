{
  "name": "decision-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @arena/web dev",
    "build": "pnpm --filter @arena/web build",
    "laya-dataset": "node packages/decisions/scripts/laya-dataset.ts",
    "laya-dagger": "node packages/decisions/scripts/laya-dagger.ts",
    "probe": "node --env-file-if-exists=.env packages/decisions/scripts/probe.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
