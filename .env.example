# Copy to .env (never commit .env). Read by the dev proxy and `pnpm probe`.

# Jev lane. https://typesafe.ai dashboard → API keys.
TYPESAFE_API_KEY=

# Clef-flash and Llama lanes (Workers AI). Account ID is on the dashboard's
# Workers AI page; create the token from the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Kev-4B on OpenRouter. Not used: the Kev lanes run self-hosted on Colab (bridge/kev).
OPENROUTER_API_KEY=

# Laya needs no key: run bridge/laya/server.py on this machine.
