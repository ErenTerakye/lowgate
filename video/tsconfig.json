{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts"]
}
