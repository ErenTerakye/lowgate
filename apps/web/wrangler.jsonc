{
  // Static assets only: the replays and results page are built from bench/ and need no server or key.
  // Deploy with `pnpm deploy:web` from the repo root (builds first).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lowgate",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "lowgate.erenterakye.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
